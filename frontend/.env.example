# Firebase web app config — copy to .env.local and fill in values
# (Client config is intentionally public; security enforced by Firebase Auth + backend token verification)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API proxy target — defaults to http://localhost:8000 (host dev).
# Inside Docker Compose this is overridden to http://fastapi:8000.
# VITE_API_TARGET=http://localhost:8000
